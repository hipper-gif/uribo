# Nicolioセッションゲート（ADR-0003・2026-09-15）: 入口を index.php に一本化
DirectoryIndex index.php
RewriteEngine On
RewriteBase /uribo/
# index.html 直叩きもゲート経由にする（ブックマークでの素通し防止）
RewriteRule ^index\.html$ /uribo/index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /uribo/index.php [L]

# index.html はキャッシュしない(コンテンツハッシュ付きJSへの参照を確実に更新)
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# ハッシュ付きアセット(/assets/index-XXXX.js等)は長期キャッシュOK
<FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|svg|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
